# Weekday reservation schedule (install with ./install-schedule.sh)
# Uses session from evening SSO — edit then re-run install-schedule.sh / install.sh --schedules

RS_SCHEDULE_TZ=Asia/Manila
# Cron DOW: 0=Sun … 6=Sat (same as crontab). Default Mon–Fri.
# Evening SSO runs RS_SCHEDULE_DAYS − 1 (e.g. 1-5 → SSO 0-4 at 9 PM).
# Override with SSO_SCHEDULE_DAYS in the SSO .env if needed.
RS_SCHEDULE_DAYS=1-5
# Target book time Asia/Manila (hh:mm:ss) — when submit.asp should fire.
# install-crontab.sh starts the book cron BOOK_PREWARM_MINUTES early (default 1)
# so run-scheduled.sh can refresh session + compile before waiting for this second.
# Example: 00:00:00 with days 2-5 → cron 23:59 on days 1-4.
RS_SCHEDULE_TIME=00:00:00

# Optional: minutes before RS_SCHEDULE_TIME to start cron (default 1). Set 0 to disable.
# BOOK_PREWARM_MINUTES=1

# Reservation date = run date + N days (Asia/Manila)
RS_RESERVATION_DAYS_AHEAD=7

# Retry until one slot from resources.txt is booked
BOOK_RETRY_TIMEOUT_SEC=180
BOOK_RETRY_SLEEP_SEC=2

# Max age of session.json from evening SSO (hours)
MAX_SESSION_AGE_HOURS=6
