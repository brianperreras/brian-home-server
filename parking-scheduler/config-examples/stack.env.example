################################################################################
# Parking stack .env — single source of truth (Unraid Compose Manager Plus)
#
# Path: /mnt/user/appdata/compose-projects/parking/.env
# Edit here (Compose → parking → .ENV tab, or nano), then recreate/restart the
# stack so the entrypoint regenerates app config + crontab.
#
# Do not put secrets in git. Values with special characters: use quotes
#   RS_PASSWORD='p@ss#word'
################################################################################

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  PATHS                                                                     ║
# ╚════════════════════════════════════════════════════════════════════════════╝
PARKING_APPDATA=/mnt/user/appdata/parking

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  SSO / LOGIN  (was config/.env)                                            ║
# ╚════════════════════════════════════════════════════════════════════════════╝
RS_USERNAME=your.username
RS_PASSWORD=your-password

RS_ENTRY_URL=https://asurion.resourcescheduler.net/
RS_DOMAIN=HQDOMAIN
HEADED=0

SSO_MAX_ATTEMPTS=3
SSO_RETRY_DELAY_MS=3000
# SSO_POST_LOGIN_TIMEOUT_MS=180000

SESSION_OUTPUT=output/session.json

# Evening SSO cron (hour/minute); DOW defaults to booking days − 1
SSO_SCHEDULE_TZ=Asia/Manila
SSO_SCHEDULE_HOUR=21
SSO_SCHEDULE_MINUTE=0
# SSO_SCHEDULE_DAYS=2-4

# Optional topic overrides (normally filled after first successful login)
# RS_TOPIC_ID=123
# RS_SCHEDULE_URL=https://asurion.resourcescheduler.net/ResourceScheduler/schedule.asp?Topic=RES&TopicId=123&CDate=2026-1-1

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  BOOKING SCHEDULE  (was schedule.env)                                      ║
# ╚════════════════════════════════════════════════════════════════════════════╝
RS_SCHEDULE_TZ=Asia/Manila
# Cron DOW: 0=Sun … 6=Sat. Book Tue–Fri → 2-5; SSO runs evening before (1-4).
RS_SCHEDULE_DAYS=2-5
# Target submit time Asia/Manila (hh:mm:ss)
RS_SCHEDULE_TIME=00:00:00
# BOOK_PREWARM_MINUTES=1

# Reservation date = run date + N (Asia/Manila). Override per run with:
#   parking book --date tomorrow
RS_RESERVATION_DAYS_AHEAD=7

BOOK_RETRY_TIMEOUT_SEC=180
BOOK_RETRY_SLEEP_SEC=2
MAX_SESSION_AGE_HOURS=6

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  RESERVATION WINDOW  (was reservation.env)                                 ║
# ╚════════════════════════════════════════════════════════════════════════════╝
# Resource Scheduler form: HOUR+AM / HOUR+PM
RS_START_HR=6+AM
RS_END_HR=3+PM
# RS_END_MIN=30

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  PARKING SLOTS  (was resources.txt) — try order, comma-separated           ║
# ╚════════════════════════════════════════════════════════════════════════════╝
# Reorder freely. Full car-slot map is in resources.txt.example in the kit.
# Example short list for testing:
PARKING_SLOTS=R405,R406,R400,R401,R402,R403,R404,R407

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  CONTAINER / STACK                                                         ║
# ╚════════════════════════════════════════════════════════════════════════════╝
TZ=Asia/Manila
PARKING_LOCAL_CREDENTIALS_ONLY=1
# Write config files inside the container from this .env on every start
PARKING_MANAGE_FROM_STACK_ENV=1
# PARKING_SKIP_CRONTAB=0
