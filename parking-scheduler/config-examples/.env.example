# Copy to .env and set local SSO credentials:
#   cp .env.example .env
# Unraid: /mnt/user/appdata/parking/config/.env
# AWS SSM is not used on Unraid — set RS_PASSWORD here.

RS_USERNAME=your.username
RS_PASSWORD=your-password

# Optional; Asurion Ping flow usually has no domain dropdown
RS_ENTRY_URL=https://asurion.resourcescheduler.net/
# Primary slot topic for SSO login + keep-alive (set by parking/install.sh)
# RS_TOPIC_ID=123
# RS_SCHEDULE_URL=https://asurion.resourcescheduler.net/ResourceScheduler/schedule.asp?Topic=RES&TopicId=123&CDate=2026-1-1

# Used when the Ping login page shows a Domain dropdown (common on root URL redirect)
RS_DOMAIN=HQDOMAIN

# Set to 1 to show the browser (useful while tuning selectors)
HEADED=0

# Retry failed SSO login (e.g. missed PingID) before giving up
SSO_MAX_ATTEMPTS=3
SSO_RETRY_DELAY_MS=3000
# Wait up to 3 minutes for PingID approval after Sign On (password-expiry + MFA)
# SSO_POST_LOGIN_TIMEOUT_MS=180000

# Where to write extracted session data
SESSION_OUTPUT=output/session.json

# Weekday scheduler (./install-schedule.sh) — 9 PM by default
# DOW defaults to RS_SCHEDULE_DAYS − 1 (evening before booking)
# (e.g. booking 3-5 → SSO 2-4). Override only if needed:
# SSO_SCHEDULE_DAYS=2-4
SSO_SCHEDULE_TZ=Asia/Manila
SSO_SCHEDULE_HOUR=21
SSO_SCHEDULE_MINUTE=0
