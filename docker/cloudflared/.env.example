# Copy to .env beside docker-compose.yml on Unraid:
#   /mnt/user/appdata/compose-projects/cloudflared/.env
# Token from: Zero Trust → Networks → Tunnels → Docker install (value after --token)
# Guide: docs/09-Network-Security.md → Part D → D4 Option A (A4)
# Never commit the real token to Git.

TUNNEL_TOKEN=paste-your-tunnel-token-here
